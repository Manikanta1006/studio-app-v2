{
  "name": "3d-dental-studio-mern",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client/client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev -w 3d-dental-studio-client\" \"npm run dev -w 3d-dental-studio-server\"",
    "dev:client": "npm run dev -w 3d-dental-studio-client",
    "dev:server": "npm run dev -w 3d-dental-studio-server",
    "build": "npm run build -w 3d-dental-studio-client && npm run build -w 3d-dental-studio-server",
    "start": "npm run start -w 3d-dental-studio-server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2",
    "zustand": "^5.0.12"
  }
}
